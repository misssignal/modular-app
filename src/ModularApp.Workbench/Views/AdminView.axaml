<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ModularApp.Workbench.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="700"
             x:Class="ModularApp.Workbench.Views.AdminView"
             x:DataType="vm:AdminViewModel">

    <ScrollViewer Padding="32,24">
        <StackPanel Spacing="28" MaxWidth="720">

            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="Lab Administration" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="Manage members, roles, and permissions for your labs"
                           FontSize="13" Opacity="0.5" />
            </StackPanel>

            <!-- Lab selector -->
            <StackPanel Spacing="8">
                <TextBlock Text="Select Lab" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding AdminLabs}"
                          SelectedItem="{Binding SelectedLab}"
                          HorizontalAlignment="Stretch"
                          PlaceholderText="Select a lab to administer" />
            </StackPanel>

            <!-- Members Section -->
            <StackPanel Spacing="12">
                <TextBlock Text="Lab Members" FontSize="16" FontWeight="SemiBold" />
                <Separator />

                <ItemsControl ItemsSource="{Binding LabMembers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LabMemberDisplay">
                            <Border Padding="12,8" Margin="0,2"
                                    CornerRadius="4"
                                    Background="{DynamicResource SystemChromeLowColor}">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding UserId}"
                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Roles}"
                                               Opacity="0.5" Margin="12,0"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Content="Remove"
                                            Command="{Binding $parent[ItemsControl].((vm:AdminViewModel)DataContext).RemoveMemberCommand}"
                                            CommandParameter="{Binding}"
                                            Padding="8,4" FontSize="11" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Add member -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox Text="{Binding NewMemberId}"
                             Watermark="Username (e.g. jsmith)"
                             Width="240" />
                    <Button Content="Add Member"
                            Command="{Binding AddMemberCommand}"
                            Padding="12,6" />
                </StackPanel>
            </StackPanel>

            <!-- Roles Section -->
            <StackPanel Spacing="12">
                <TextBlock Text="Roles" FontSize="16" FontWeight="SemiBold" />
                <Separator />

                <ItemsControl ItemsSource="{Binding LabRoles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LabRoleDisplay">
                            <Border Padding="12,8" Margin="0,2"
                                    CornerRadius="4"
                                    Background="{DynamicResource SystemChromeLowColor}">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Level}"
                                                   Opacity="0.5" FontSize="11" />
                                    </Grid>
                                    <TextBlock Text="{Binding RoleId}"
                                               FontSize="11" Opacity="0.4" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Create role -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox Text="{Binding NewRoleId}"
                             Watermark="Role ID (e.g. reviewer)"
                             Width="160" />
                    <TextBox Text="{Binding NewRoleDisplayName}"
                             Watermark="Display Name"
                             Width="160" />
                    <ComboBox ItemsSource="{Binding AvailablePermissionLevels}"
                              SelectedItem="{Binding NewRoleLevel}"
                              Width="120" />
                    <Button Content="Create Role"
                            Command="{Binding CreateRoleCommand}"
                            Padding="12,6" />
                </StackPanel>
            </StackPanel>

            <!-- Module Access Section -->
            <StackPanel Spacing="12">
                <TextBlock Text="Module Access" FontSize="16" FontWeight="SemiBold" />
                <Separator />

                <ItemsControl ItemsSource="{Binding ModulePermissions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ModulePermissionDisplay">
                            <Border Padding="12,8" Margin="0,2"
                                    CornerRadius="4"
                                    Background="{DynamicResource SystemChromeLowColor}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding ModuleName}"
                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding ModuleId}"
                                               Opacity="0.4" FontSize="11"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Status -->
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="12" Opacity="0.6"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
