<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
             x:Class="ModularApp.Workbench.Views.ModuleErrorView">

    <Border Margin="24" Padding="24" CornerRadius="8"
            Background="{DynamicResource SystemChromeLowColor}">
        <StackPanel Spacing="16">
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold"
                       Foreground="Red" />
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
            <ScrollViewer MaxHeight="300">
                <TextBlock x:Name="StackTraceText" FontFamily="Consolas,Menlo,monospace"
                           FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
            </ScrollViewer>
            <Button x:Name="RetryButton" Content="Retry" HorizontalAlignment="Left" />
        </StackPanel>
    </Border>
</UserControl>
