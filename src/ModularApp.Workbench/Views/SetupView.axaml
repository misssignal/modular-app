<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ModularApp.Workbench.ViewModels"
             xmlns:svc="using:ModularApp.Workbench.Services"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
             x:Class="ModularApp.Workbench.Views.SetupView"
             x:DataType="vm:SetupViewModel">

    <Design.DataContext>
        <vm:SetupViewModel />
    </Design.DataContext>

    <!-- Full-screen centered setup card -->
    <Grid Background="{DynamicResource SystemChromeLowColor}">
        <Border VerticalAlignment="Center"
                HorizontalAlignment="Center"
                MaxWidth="520"
                Padding="40"
                CornerRadius="12"
                Background="{DynamicResource SystemRegionColor}"
                BoxShadow="0 4 24 0 #30000000">

            <StackPanel Spacing="24">
                <!-- Header -->
                <StackPanel Spacing="4">
                    <TextBlock Text="CRATE" FontSize="28" FontWeight="Bold"
                               Foreground="#0066CC" />
                    <TextBlock Text="Workbench — First-Time Setup" FontSize="14"
                               Opacity="0.6" />
                </StackPanel>

                <Separator />

                <!-- Authorization -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Authorization Token" FontWeight="SemiBold" />
                    <TextBox PasswordChar="●"
                             Text="{Binding Token}"
                             Watermark="Enter your CRATE authorization token"
                             RevealPassword="False" />
                </StackPanel>

                <!-- Bench Identity -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Bench / Workstation" FontWeight="SemiBold" />
                    <TextBox Text="{Binding BenchName}"
                             Watermark="e.g. VSCL-Bench-03" />

                    <Grid ColumnDefinitions="*,16,*" Margin="0,4,0,0">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Username" FontSize="11" Opacity="0.5" />
                            <TextBlock Text="{Binding Username}" FontSize="12"
                                       Opacity="0.7" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="Hostname" FontSize="11" Opacity="0.5" />
                            <TextBlock Text="{Binding Hostname}" FontSize="12"
                                       Opacity="0.7" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Lab / Work Area (multi-select) -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Labs / Work Areas" FontWeight="SemiBold" />
                    <TextBlock Text="Select all labs you work with in this session"
                               FontSize="12" Opacity="0.5" />

                    <ItemsControl ItemsSource="{Binding LabAreas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="svc:LabAreaOption">
                                <Button Background="Transparent"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="8,6"
                                        Margin="0,1"
                                        Command="{Binding $parent[ItemsControl].((vm:SetupViewModel)DataContext).ToggleLabCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock Text="{Binding ModuleSourceUri}"
                                                   FontSize="10" Opacity="0.3"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Selected labs summary -->
                    <TextBlock Text="{Binding SelectedLabsSummary}"
                               FontSize="12" Opacity="0.6" FontWeight="SemiBold"
                               IsVisible="{Binding SelectedLabsSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>

                <!-- Error message -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="Red" FontSize="12"
                           TextWrapping="Wrap"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <!-- Complete button -->
                <Button Content="Complete Setup"
                        Command="{Binding CompleteSetupCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="12,10"
                        FontWeight="SemiBold"
                        Classes="accent" />

                <!-- Processing indicator -->
                <StackPanel Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Center"
                            IsVisible="{Binding IsProcessing}">
                    <ProgressBar IsIndeterminate="True" Width="120" Height="4" />
                    <TextBlock Text="Activating..." FontSize="12" Opacity="0.6" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
